{
    "name": "tech-nova/spip-linkedin-post",
    "description": "SPIP plugin to import LinkedIn posts",
    "type": "spip-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.4",
        "spip-league/easy-coding-standard": "^1.1",
        "spip-league/rector": "dev-main",
        "spip/tests": "dev-master"
    },
    "repositories": [
        {
            "name": "spip",
            "type": "composer",
            "url": "https://get.spip.net/composer"
        },
        {
            "name": "spip-tests",
            "type": "vcs",
            "url": "https://git.spip.net/spip/tests.git"
        }
    ],
    "scripts": {
        "check-cs": "vendor/bin/ecs check --ansi",
        "fix-cs": "vendor/bin/ecs check --fix --ansi",
        "rector": "vendor/bin/rector process --ansi",
        "rector-dry-run": "vendor/bin/rector process --dry-run --ansi",
        "tests-unit": "vendor/bin/phpunit --colors --testsuite unit -c phpunit.xml",
        "tests-integration": "vendor/bin/phpunit --colors --testsuite integration --bootstrap tests/bootstrap_integration.php -c phpunit.xml"
    },
    "config": {
        "sort-packages": true
    }
}
